# =========================
# App
# =========================

PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Expo client API URL. Use your LAN IP when testing on a physical phone,
# for example: http://192.168.1.8:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# JWT signing secret. Use a strong random value in production.
JWT_SECRET=change-me

# =========================
# MongoDB
# =========================

# If MONGODB_URI is set, the split fields below are ignored.
MONGODB_URI=mongodb://127.0.0.1:27017/ai-gallery
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=ai-gallery
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=

# =========================
# Admin Login
# =========================

# Generate a local keypair with: pnpm gen:rsa
# Store newlines as \n when writing PEM values into .env.
ADMIN_LOGIN_RSA_PRIVATE_KEY=
ADMIN_LOGIN_RSA_PUBLIC_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# =========================
# OpenAI Image Generation
# =========================

# Used when a user does not provide an API key in the web UI.
OPENAI_API_KEY=

# OpenAI-compatible image API base URL.
OPENAI_IMAGE_BASE_URL=https://sub.appdock.cn/v1

# Upstream timeout in milliseconds.
OPENAI_UPSTREAM_TIMEOUT_MS=600000

# Enable streaming image responses when the upstream supports SSE.
OPENAI_IMAGE_STREAM=true
OPENAI_IMAGE_PARTIAL_IMAGES=1
OPENAI_IMAGE_EDIT_STREAM=true

# =========================
# Uploads
# =========================

# Public API URL used to build local upload URLs.
PUBLIC_API_BASE_URL=http://localhost:4000

# Local fallback storage when Qiniu is not configured.
LOCAL_UPLOAD_DIR=./uploads

# Request body limit for image edit reference uploads.
REQUEST_BODY_LIMIT=25mb

# Optional Qiniu object storage. Leave blank to use local uploads.
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_PUBLIC_DOMAIN=
QINIU_UPLOAD_URL=https://upload.qiniup.com
QINIU_KEY_PREFIX=gallery
QINIU_UPLOAD_TOKEN_EXPIRES=3600
